rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil: uno por usuario, con el id igual a su uid de Auth.
    // Solo el backend (Admin SDK) crea y borra perfiles; el cliente nunca.
    match /users/{userId} {
      allow read: if request.auth != null
                    && request.auth.uid == userId;

      // El usuario puede corregir su nombre, pero no tocar uid, email ni rol.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['fullName'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0;

      allow create, delete: if false;

      // Acciones registradas por el propio usuario (resumen de Hoy).
      match /actions/{actionId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Eventos de analítica.
    //
    // Cada usuario:
    // - puede crear únicamente eventos propios;
    // - puede leer únicamente sus propios eventos;
    // - no puede editar ni eliminar eventos.
    //
    // Para BQ 4 usamos:
    //   name   = "activity_selected"
    //   source = "library" | "custom"
    //
    // Flutter y Kotlin pueden registrar eventos.
    match /events/{eventId} {

      allow create: if request.auth != null
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.name == "activity_selected"
                    && request.resource.data.source in [
                      "library",
                      "custom"
                    ]
                    && request.resource.data.platform in [
                      "flutter",
                      "kotlin"
                    ]
                    && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null
                  && resource.data.teacherId == request.auth.uid
                  && resource.data.name == "activity_selected";

      allow update, delete: if false;
    }

    // Todo lo que no coincida arriba queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}