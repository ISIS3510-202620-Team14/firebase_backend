# Web API key del proyecto (Consola Firebase > Configuracion del proyecto > General).
# No es un secreto: es la misma clave que ya viaja dentro de la app.
WEB_API_KEY=AIza...

# Remitente de los correos (Brevo). Debe estar verificado en Brevo > Senders.
CORREO_REMITENTE=tu-correo@ejemplo.com
NOMBRE_REMITENTE=ENAd Móvil

# La clave de Brevo NO va aquí: es un secreto.
#   Produccion: firebase functions:secrets:set BREVO_API_KEY
#   Emulador:   functions/.secret.local con BREVO_API_KEY=xkeysib-...
